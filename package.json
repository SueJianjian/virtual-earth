{
  "name": "virtual-earth",
  "version": "0.1.1",
  "description": "A deterministic autonomous virtual planet observer",
  "author": "Virtual Earth",
  "private": true,
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:dist": "npm run build && electron-builder --win portable",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "benchmark:dense": "node --experimental-strip-types scripts/benchmark.ts 100 123 dense",
    "benchmark:dense:default": "node --experimental-strip-types scripts/benchmark.ts 100 123 dense 96 48",
    "benchmark:soak": "node --experimental-strip-types scripts/benchmark.ts 1000 123 dense 96 48"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/three": "^0.185.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "build": {
    "appId": "com.virtualearth.observer",
    "productName": "Virtual Earth",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "VirtualEarth-${version}-${arch}.${ext}"
    }
  }
}
